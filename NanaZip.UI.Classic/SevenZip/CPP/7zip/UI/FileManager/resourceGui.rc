#include "resourceGui.h"

STRINGTABLE
BEGIN
  IDS_MESSAGE_NO_ERRORS     "There are no errors"

  IDS_PROGRESS_TESTING      "Testing"

  IDS_CHECKSUM_CALCULATING    "Checksum calculating..."
  IDS_CHECKSUM_INFORMATION    "Checksum information"
  IDS_CHECKSUM_CRC_DATA       "CRC checksum for data:"
  IDS_CHECKSUM_CRC_DATA_NAMES "CRC checksum for data and names:"
  IDS_CHECKSUM_CRC_STREAMS_NAMES "CRC checksum for streams and names:"

  IDS_INCORRECT_VOLUME_SIZE "Incorrect volume size"

  IDS_OPENNING  "Opening..."
  IDS_SCANNING  "Scanning..."

  // **************** NanaZip Modification Start ****************
  // The three entries of IDC_SETTINGS_THEME_MODE, in the order of the theme
  // modes the settings page offers.
  IDS_SETTINGS_THEME_MODE_SYSTEM   "Follow the system"
  IDS_SETTINGS_THEME_MODE_LIGHT    "Always light"
  IDS_SETTINGS_THEME_MODE_DARK     "Always dark"
  // **************** NanaZip Modification End ****************

  // **************** NanaZip Modification Start ****************
  // The Hello consent lines for the password dialog's vault buttons; the
  // core library carries no resources of its own.
  IDS_VAULT_PROMPT_USE  "Unlock the NanaZip vault to use this password"
  IDS_VAULT_PROMPT_SAVE "Save password to the NanaZip vault"
  // **************** NanaZip Modification End ****************

  // **************** NanaZip Modification Start ****************
  // Vault strings. The warning states the threat model: what Hello does and
  // does not protect. \n breaks a line; there is no \" escape, so the delete
  // confirmation uses single quotes.
  IDS_VAULT_ENABLE_TITLE   "Enable the vault?"
  IDS_VAULT_ENABLE_WARNING "Windows Hello is a convenience here, not a data lock:\n\n1. Any program running as you can read the vault files without Hello. The real boundary is your Windows sign-in and DPAPI.\n2. Anyone with physical access to an unlocked session can read the vault.\n3. If an administrator resets your Windows password, the vault data cannot be recovered; a backup of the vault folder cannot be decrypted either.\n4. The vault asks for Hello when it unlocks, then stays unlocked until a timer locks it or the app closes; reading or copying an entry while unlocked is not asked again, and none of this is absolute security."
  IDS_VAULT_HELLO_UNAVAILABLE "Windows Hello is not available on this device. Set up a PIN or Windows Hello in the Settings app, then try again."
  IDS_VAULT_OPEN_FAILED "The vault storage could not be opened."
  IDS_VAULT_SAVE_FAILED "The entry could not be saved."
  IDS_VAULT_LOCKED "The vault is locked."
  IDS_VAULT_UNLOCK "&Unlock"
  IDS_VAULT_LOCK "&Lock"
  IDS_VAULT_COLUMN_ARCHIVE "Archive"
  IDS_VAULT_COLUMN_LABEL "Label"
  IDS_VAULT_ENTRY_COUNT "{0} entry(s)"
  IDS_VAULT_PROMPT_UNLOCK "Unlock the NanaZip vault"
  IDS_VAULT_HELLO_FAILED "Windows Hello did not verify. The vault stays locked."
  IDS_VAULT_DECRYPT_FAILED "The secret could not be read. The Windows account that wrote it may have changed."
  IDS_VAULT_COPIED "The password was copied to the clipboard. It will be cleared automatically."
  IDS_VAULT_CLIPBOARD_CLEARED "The clipboard was cleared."
  IDS_VAULT_CLIPBOARD_CLEAR_FAILED "The clipboard could not be cleared. The password may still be on it."
  IDS_VAULT_DELETE_CONFIRM "Delete the entry '{0}'?"
  IDS_VAULT_COPY_FAILED "The password could not be copied to the clipboard."
  IDS_VAULT_DELETE_FAILED "The entry could not be deleted."
  IDS_VAULT_DISABLED "The vault is disabled."
  // The vault settings dialog carries its labels as plain text, like every
  // other Classic dialog, so only the rejection message is needed from here.
  IDS_VAULT_SETTINGS_INVALID "Each timer needs a whole number of seconds inside the range the vault allows. The two lock timers also accept 0, which keeps the vault unlocked until NanaZip exits; the clipboard timer does not."
  IDS_VAULT_UNLOCK_FAILED "The vault could not be unlocked. Nothing was read or written; try again."
  // **************** NanaZip Modification End ****************
END
