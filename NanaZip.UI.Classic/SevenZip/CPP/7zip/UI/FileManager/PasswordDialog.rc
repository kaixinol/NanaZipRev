#include "PasswordDialogRes.h"
#include "../../GuiCommon.rc"

#define xc 140
// **************** NanaZip Modification Start ****************
// #define yc 72
#define yc 104
// **************** NanaZip Modification End ****************

IDD_PASSWORD  DIALOG  0, 0, xs, ys  MY_MODAL_DIALOG_STYLE  MY_FONT
CAPTION "Enter password"
BEGIN
  LTEXT    "&Enter password:", IDT_PASSWORD_ENTER, m, m, xc, 8
  EDITTEXT  IDE_PASSWORD_PASSWORD, m, 20, xc, 14, ES_PASSWORD | ES_AUTOHSCROLL
  // **************** NanaZip Modification Start ****************
  CONTROL  "Save password to &vault", IDX_PASSWORD_SAVE_TO_VAULT, MY_CHECKBOX, m, 40, xc, 10
  LTEXT    "Vault:", IDT_PASSWORD_VAULT_SUGGEST, m, 56, 48, 8
  COMBOBOX  IDC_PASSWORD_VAULT_SUGGEST, 60, 54, xc - 60 + m, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  // CONTROL  "&Show password", IDX_PASSWORD_SHOW, MY_CHECKBOX, m, 42, xc, 10
  CONTROL  "&Show password", IDX_PASSWORD_SHOW, MY_CHECKBOX, m, 74, xc, 10
  // **************** NanaZip Modification End ****************
  OK_CANCEL
END
